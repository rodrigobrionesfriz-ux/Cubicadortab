rules_version = '2';

// Reglas para el Cubicador de Melamina.
// Cada proyecto pertenece al uid anónimo que lo creó: nadie más puede leerlo,
// editarlo ni borrarlo, aunque conozca el ID del documento.
//
// Cómo aplicarlas:
//   Consola de Firebase -> Firestore Database -> pestaña "Reglas"
//   -> pega este contenido -> Publicar.

service cloud.firestore {
  match /databases/{database}/documents {

    match /proyectos/{proyectoId} {

      // Leer / modificar / borrar: solo el dueño del documento.
      allow read, update, delete: if request.auth != null
                                  && resource.data.uid == request.auth.uid;

      // Crear: el uid del documento debe ser el del usuario autenticado,
      // y el nombre debe ser un texto razonable.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.nombre is string
                    && request.resource.data.nombre.size() > 0
                    && request.resource.data.nombre.size() < 120;
    }

    // Todo lo demás queda bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
